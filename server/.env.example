# Cadena de conexión a MongoDB.
# Local con Docker:  mongodb://localhost:27017/guard-schedule
# Atlas:             mongodb+srv://usuario:password@cluster.mongodb.net/guard-schedule
DATABASE_URL=mongodb://localhost:27017/guard-schedule

# Secreto con el que se firman los JWT. Generá uno propio y largo.
# Podés obtener uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=cambiame-por-un-secreto-de-verdad

# Puerto donde escucha la API.
PORT=8252
